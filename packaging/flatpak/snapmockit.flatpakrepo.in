# Adds Snapmockit's Flatpak repository alone (docs/Flatpak-Repository-Implementation.md).
# Filled by packaging/flatpak/publish.py, which writes the Flatpak repository's address
# into Url and the public key, base64, into GPGKey. A .flatpakrepo cannot name a
# runtime's source, so the KDE runtime comes from Flathub only where Flathub is already
# added.
[Flatpak Repo]
Title=Snapmockit
Url=@URL@
Homepage=https://github.com/dbower44022/snapmockit
Comment=Snapmockit's own Flatpak repository
DefaultBranch=stable
GPGKey=@GPGKEY@
